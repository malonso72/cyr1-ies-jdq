# ═══════════════════════════════════════════════════════════════
# CyR 1º ESO · IES Jiménez de Quesada
# Cabeceras de caché y seguridad · compatibles con Cloudflare Workers
# y Netlify (misma sintaxis)
# ═══════════════════════════════════════════════════════════════

# ─── Imágenes · cache 1 año ─────────────────────────────────────
/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ─── CSS y JS · revalidar siempre ───────────────────────────────
# Los archivos no llevan huella en el nombre (common.css, academia.js, s03.js…) y las
# páginas los enlazan sin ?v=. Con «1 año, immutable» un navegador que ya los tenía
# no volvía a pedirlos hasta dentro de un año: los arreglos de JS y CSS no llegaban a
# los alumnos. Con max-age=0 el navegador pregunta cada vez y el ETag responde «no ha
# cambiado» (304) sin descargar nada: cuesta una petición mínima y siempre está al día.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# ─── Fuentes · cache 1 año ──────────────────────────────────────
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.otf
  Cache-Control: public, max-age=31536000, immutable

# ─── PDFs · cache 1 mes ─────────────────────────────────────────
/*.pdf
  Cache-Control: public, max-age=2592000

# ─── HTML · cache muy corto + revalidación ──────────────────────
/*.html
  Cache-Control: public, max-age=60, must-revalidate

# ─── XML · forzar Content-Type correcto ─────────────────────────
/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# ─── robots.txt · texto plano explícito ─────────────────────────
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# ─── Cabeceras de seguridad para todo el sitio ──────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
