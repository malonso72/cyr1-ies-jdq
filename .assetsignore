# ═══════════════════════════════════════════════════════════════
# Cloudflare Workers Static Assets — exclusiones
# Misma sintaxis que .gitignore
# ═══════════════════════════════════════════════════════════════

# Carpeta interna de git (puede ser enorme, no se publica)
.git
.git/
.git/**
.git/objects/**
.git/objects/pack/**
**/.git/**
**/*.pack
**/*.idx

# Documentación interna del proyecto (no para el público)
documentacion/
CLAUDE.md
README.md
.gitignore

# Herramientas de construcción y verificación: se usan en local, no se sirven
scripts/
node_modules/

# Plantillas de página: son material de partida, no páginas del sitio
assets/templates/

# Capturas de trabajo que deja Claude (no para el público)
Claude outputs/

# Material privado de soluciones (no para el público)
_soluciones/

# Fuente editable de la Academia (se publica ya en /trimestres/t3-ciberseguridad/)
_academia-v3/

# Versión v2 (cuadernillo) archivada tras la migración a la Academia
trimestres/t3-ciberseguridad/_legacy-v2/

# Configuración interna de Cloudflare/wrangler
wrangler.toml
.wrangler/

# Versiones antiguas de archivos en formato editable
*.docx
*.zip
*.tar
*.tar.gz

# Editores
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Antiguos archivos de Pages renombrados a .disabled
_redirects.disabled
